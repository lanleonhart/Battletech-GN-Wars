CustomFilters/Settings.last.json
ModTek/config.help.json
ModTek/config.last.json

# MissionMusicSelector scans this folder for whatever the player drops in.
# Tracks are the player's own; do not redistribute audio here.
MissionMusicSelector/Music/*
!MissionMusicSelector/Music/_README.txt

# Mod documentation players need, despite the blanket *.md / *.txt rules above
!MechColors/CONFIG.md

# A mod save that belongs in <game>\ModSaves, not inside a mod folder. It shipped to every player.
ModSaves/

# Files the mods write as the game runs. This checkout doubles as a live mod folder, so they
# reappear constantly; none of them ship (build\modpack.json "generated" excludes them too).
modstate.json
stack_sequence.txt
