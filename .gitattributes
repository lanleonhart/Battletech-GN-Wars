# Enforce LF line endings for all text files
# This ensures consistent hashes between Windows/Mac/Linux

# Auto detect text files and normalize to LF
* text=auto eol=lf

# Explicitly set LF for common file types
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cs text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files (no line ending conversion)
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.bundle binary
*.assetbundle binary
*.wav binary
*.mp3 binary
*.ogg binary
